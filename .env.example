# PORTS
HYRAX_SERVER_HTTP_PORT=3000
HYRAX_CLIENT_PORT=5173
HYRAX_DB_PORT=5432
HYRAX_REDIS_PORT=6379

# SERVER
HYRAX_DEV_MODE=true
HYRAX_SERVER_CORS_ORIGINS=http://localhost:4200,http://localhost:5173
HYRAX_SERVER_WINDOW_MS_MINUTES=15
HYRAX_SERVER_REQUEST_LIMIT=1000

# DB
HYRAX_DB_NAME=name
HYRAX_DB_USER=user
HYRAX_DB_PASSWORD=password
HYRAX_DB_URL=postgresql://${HYRAX_DB_USER}:${HYRAX_DB_PASSWORD}@db:5432/${HYRAX_DB_NAME}?schema=public

# REDIS
HYRAX_REDIS_URL=redis://redis:6379
HYRAX_REDIS_PASSWORD=123456
HYRAX_REDIS_CACHE_TTL_SECONDS=60

# JWT
HYRAX_JWT_SECRET=change-me-in-production
HYRAX_JWT_ACCESS_TOKEN_TTL_MINUTES=15
HYRAX_JWT_REFRESH_TOKEN_TTL_DAYS=30
