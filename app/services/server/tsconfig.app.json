{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs",
    "src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "../../server-libs/nest-launcher/tsconfig.lib.json"
    },
    {
      "path": "../../server-libs/redis/tsconfig.lib.json"
    },
    {
      "path": "../../server-libs/database/tsconfig.lib.json"
    },
    {
      "path": "../../server-libs/auth-session-feature/tsconfig.lib.json"
    },
    {
      "path": "../../server-libs/auth-feature/tsconfig.lib.json"
    },
    {
      "path": "../../server-libs/auth-core/tsconfig.lib.json"
    },
    {
      "path": "../../server-libs/auth-admin-feature/tsconfig.lib.json"
    },
    {
      "path": "../../core-libs/validation-messages/tsconfig.lib.json"
    },
    {
      "path": "../../core-libs/validation-config/tsconfig.lib.json"
    },
    {
      "path": "../../server-libs/pet-feature/tsconfig.lib.json"
    }
  ]
}
