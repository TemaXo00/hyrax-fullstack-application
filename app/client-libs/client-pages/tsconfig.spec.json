{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/spec",
    "types": ["vite/client", "vitest/globals"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
